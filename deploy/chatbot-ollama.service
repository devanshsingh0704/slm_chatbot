# Example systemd user service for the model server. Copy to ~/.config/systemd/user/ on the GPU machine,
# then: systemctl --user daemon-reload && systemctl --user start chatbot-ollama
[Unit]
Description=Chatbot model server (Ollama on localhost:11437)

[Service]
Environment=OLLAMA_HOST=127.0.0.1:11437
Environment=OLLAMA_MODELS=%h/slm_chatbot/models
# unload the model after 10 idle minutes, so the GPU is free for other jobs
Environment=OLLAMA_KEEP_ALIVE=10m
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_NUM_PARALLEL=4
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
